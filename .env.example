# Airtable Personal Access Token (data.records:read scope, restricted to PMO base)
# Never commit the real value.
AIRTABLE_TOKEN=

# PMO Base ID (not a secret, but kept here for convenience)
AIRTABLE_BASE_ID=apppc8tQLwGbF4rPp

# Shared password to gate the whole app (see src/middleware.ts). Anyone with
# this password can access the site; it's not per-user auth, just a simple
# lock on the URL. Never commit the real value.
SITE_PASSWORD=

# Groq API key (free tier, no credit card) — enables the natural-language
# chat in /ask. If unset, /ask falls back to the rule-based parser instead.
# Get one at https://console.groq.com (API Keys).
GROQ_API_KEY=

# Optional: override the default Groq model (openai/gpt-oss-120b). See
# console.groq.com/docs/models for current free-tier models.
GROQ_MODEL=
