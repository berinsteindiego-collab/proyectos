# Airtable Personal Access Token (data.records:read scope, restricted to PMO base)
# Never commit the real value.
AIRTABLE_TOKEN=

# PMO Base ID (not a secret, but kept here for convenience)
AIRTABLE_BASE_ID=apppc8tQLwGbF4rPp

# Shared password to gate the whole app (see src/middleware.ts). Anyone with
# this password can access the site; it's not per-user auth, just a simple
# lock on the URL. Never commit the real value.
SITE_PASSWORD=

# Groq API key — enables natural-language chat. Server-side only.
GROQ_API_KEY=

# Optional: override the default Groq model.
GROQ_MODEL=

# Conviva Application credentials for read-only live audience queries.
# Server-side only. Never prefix these with NEXT_PUBLIC_.
CONVIVA_CLIENT_ID=
CONVIVA_CLIENT_SECRET=
